<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Starts ProfileWatcherService after device boot in whatever user context
             BOOT_COMPLETED fires. In user 0 this keeps the service alive in the
             primary user so SCREEN_OFF is received even while Private Space is locked. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shared trampoline implementation. Not a launcher entry itself;
             launch surfaces are the activity-alias entries below. -->
        <activity
            android:name=".LaunchWA"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true" />

        <!--
            Launcher aliases for each clone-profile WhatsApp instance.
            Each alias reads its target_user_id meta-data at runtime, so adding
            another instance only requires:
              1. pm create-user -\-profileOf 0 -\-user-type android.os.usertype.profile.CLONE <name>
              2. pm install-existing -\-user <id> com.whatsapp
              3. Add one more <activity-alias> block below with the new id and label.
              4. Add a color, background drawable, and mipmap adaptive-icon for the new alias.
            ProfileWatcherService.resolveManagedUserIds() reads these same meta-data ints
            to know which users to stop on SCREEN_OFF — no other config needed.
        -->

        <activity-alias
            android:name=".LaunchWA1"
            android:targetActivity=".LaunchWA"
            android:label="WA1"
            android:icon="@mipmap/ic_wa1"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="target_user_id"
                android:value="11" />
        </activity-alias>

        <activity-alias
            android:name=".LaunchWA2"
            android:targetActivity=".LaunchWA"
            android:label="WA2"
            android:icon="@mipmap/ic_wa2"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="target_user_id"
                android:value="12" />
        </activity-alias>

        <activity-alias
            android:name=".LaunchWA3"
            android:targetActivity=".LaunchWA"
            android:label="WA3"
            android:icon="@mipmap/ic_wa3"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="target_user_id"
                android:value="13" />
        </activity-alias>

        <activity-alias
            android:name=".LaunchWA4"
            android:targetActivity=".LaunchWA"
            android:label="WA4"
            android:icon="@mipmap/ic_wa4"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="target_user_id"
                android:value="14" />
        </activity-alias>

        <activity-alias
            android:name=".LaunchWA5"
            android:targetActivity=".LaunchWA"
            android:label="WA5"
            android:icon="@mipmap/ic_wa5"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="target_user_id"
                android:value="15" />
        </activity-alias>

        <!-- Foreground service that registers a runtime SCREEN_OFF receiver and stops
             clone-profile WhatsApp instances when the screen locks. specialUse type is
             required on API 34+; the property below is its mandatory subtype description. -->
        <service
            android:name=".ProfileWatcherService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Managing WhatsApp clone profile lifecycle" />
        </service>

    </application>

</manifest>
